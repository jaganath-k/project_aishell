{
  "name": "cd",
  "summary": "change the working directory",
  "description": "Change the current working directory to DIR. With no argument, changes to the directory named in $HOME.",
  "options": [
    {
      "short": "h",
      "long": "help",
      "datatype": null,
      "description": "show help and exit",
      "required": false
    },
    {
      "short": null,
      "long": "help-json",
      "datatype": null,
      "description": "print machine-readable help as JSON",
      "required": false
    },
    {
      "short": null,
      "long": null,
      "datatype": "DIR",
      "description": "directory to change to (default: $HOME)",
      "required": false
    }
  ]
}
