{
  "version": "1.0",
  "commands": [
    {
      "id": "find_large_files",
      "aliases": [
        "find large files",
        "large files",
        "big files",
        "biggest files",
        "largest files on disk",
        "what is taking disk space"
      ],
      "description": "Find the 20 largest files on the system",
      "command": "find / -xdev -type f -size +10M -ls | sort -k7 -rn | head -20",
      "category": "filesystem",
      "requires_arg": false
    },
    {
      "id": "disk_usage",
      "aliases": [
        "disk usage",
        "how much disk",
        "disk space",
        "show disk usage",
        "storage usage",
        "df",
        "how full is the disk"
      ],
      "description": "Show disk usage summary sorted by size",
      "command": "du -sh /home /tmp /var /usr | sort -rh | head -20",
      "category": "filesystem",
      "requires_arg": false
    },
    {
      "id": "delete_older_than_days",
      "aliases": [
        "delete old files",
        "remove files older than",
        "clean old files",
        "delete files older than",
        "remove old files",
        "cleanup old files",
        "purge old files"
      ],
      "description": "Delete files older than N days in a given path",
      "command": "find {path} -type f -mtime +{days} -delete",
      "category": "filesystem",
      "requires_arg": true,
      "args": ["path", "days"]
    },
    {
      "id": "find_by_name",
      "aliases": [
        "find file",
        "search for file",
        "locate file",
        "find a file named",
        "where is file"
      ],
      "description": "Find a file by name under the current directory",
      "command": "find . -type f -name '{name}'",
      "category": "filesystem",
      "requires_arg": true,
      "args": ["name"]
    },
    {
      "id": "list_processes",
      "aliases": [
        "list processes",
        "what is running",
        "show processes",
        "running processes",
        "show all processes",
        "ps",
        "process list"
      ],
      "description": "Show all running processes with details",
      "command": "ps -ef",
      "category": "process",
      "requires_arg": false
    },
    {
      "id": "top_processes_cpu",
      "aliases": [
        "top cpu processes",
        "cpu usage",
        "processes by cpu",
        "which process is using cpu",
        "high cpu",
        "cpu consuming processes"
      ],
      "description": "Show top 15 processes sorted by CPU usage",
      "command": "ps -eo pid,ppid,cmd,%cpu,%mem --sort=-%cpu | head -15",
      "category": "process",
      "requires_arg": false
    },
    {
      "id": "top_processes_mem",
      "aliases": [
        "memory usage",
        "processes by memory",
        "which process is using memory",
        "high memory",
        "top memory processes",
        "memory consuming processes",
        "free memory"
      ],
      "description": "Show top 15 processes sorted by memory usage",
      "command": "ps -eo pid,ppid,cmd,%cpu,%mem --sort=-%mem | head -15",
      "category": "process",
      "requires_arg": false
    },
    {
      "id": "kill_process_by_name",
      "aliases": [
        "kill process",
        "stop process",
        "terminate process",
        "kill program"
      ],
      "description": "Kill all processes with the given name",
      "command": "pkill -f {name}",
      "category": "process",
      "requires_arg": true,
      "args": ["name"]
    },
    {
