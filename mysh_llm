#!/usr/bin/env python3
"""
mysh_llm — natural language → shell command translator.

Reads the live command catalog from ./aishell --commands-json,
then uses keyword matching against command names, summaries, and
descriptions to suggest the best matching command.

Usage: mysh_llm "natural language query"
Prints exactly one suggested shell command to stdout.
"""
import sys
import json
import subprocess
import os

# ── Load live command catalog from ./aishell --commands-json ─────────────────
def load_catalog():
    try:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        shell_bin  = os.path.join(script_dir, "aishell")
        result = subprocess.run(
            [shell_bin, "--commands-json"],
            capture_output=True, text=True, timeout=3
        )
        data = json.loads(result.stdout)
        return data.get("commands", [])
    except Exception:
        return []

# ── Score a command against the query ─────────────────────────────────────────
def score(cmd, words):
    text = " ".join([
        cmd.get("name", ""),
        cmd.get("summary", ""),
        cmd.get("description", "")
    ]).lower()
    return sum(1 for w in words if w in text)

# ── Keyword overrides for common shell idioms ──────────────────────────────────
OVERRIDES = [
    (["list", "c file"],            "ls | /usr/bin/grep -F .c"),
    (["list", "c source"],          "ls | /usr/bin/grep -F .c"),
    (["list", "header"],            "ls | /usr/bin/grep -F .h"),
    (["count", "line", "c"],        "wc -l *.c"),
    (["count", "line"],             "wc -l *"),
    (["find", "c file"],            "find . -n *.c -t f"),
    (["find", "directory"],         "find . -t d"),
    (["disk", "space"],             "df -h"),
    (["memory"],                    "free -h"),
    (["process", "running"],        "ps -e"),
    (["who", "logged"],             "who"),
    (["current", "directory"],      "pwd"),
    (["date"],                      "date"),
    (["time"],                      "date"),
]

def check_overrides(query):
    q = query.lower()
    for keywords, suggestion in OVERRIDES:
        if all(k in q for k in keywords):
            return suggestion
    return None

# ── Main ───────────────────────────────────────────────────────────────────────
def main():
    query = " ".join(sys.argv[1:]).strip() if len(sys.argv) > 1 else ""
    if not query:
        print("echo unknown-query")
        return

    # 1. Check keyword overrides first (fast path for idioms)
    override = check_overrides(query)
    if override:
        print(override)
        return

    # 2. Load live catalog and score each command
    catalog = load_catalog()
    words   = [w for w in query.lower().split() if len(w) > 2]

    if catalog and words:
        best     = max(catalog, key=lambda c: score(c, words))
        best_score = score(best, words)
        if best_score > 0:
            name = best["name"]
            # Build a useful default invocation for common commands
            DEFAULTS = {
                "ls":    "ls -l",
                "wc":    "wc -l *.c",
                "sort":  "sort",
                "grep":  "ls | /usr/bin/grep",
                "find":  "find . -n *.c -t f",
                "ps":    "ps -e",
                "jobs":  "jobs",
                "cat":   "cat",
                "echo":  "echo hello",
                "date":  "date",
                "pwd":   "pwd",
            }
            print(DEFAULTS.get(name, name))
            return

    # 3. Fallback: echo first alphanumeric word of the query
    words_alpha = [w for w in query.split() if w.isalnum()]
    print("echo " + (words_alpha[0] if words_alpha else "unknown"))

if __name__ == "__main__":
    main()
